rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all (Phase 4 Principle 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc for initial boot verification
    match /test/connection {
      allow read, write: if true;
    }

    // User data isolated strictly by authenticated UID (Requirement 2 & 4)
    // Only authenticated users can access their own data under users/{userId}/**.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
