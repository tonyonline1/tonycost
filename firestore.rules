rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read, write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Ingredients
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Sauces & Sub-recipes
    match /sauces/{sauceId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Menu Items
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Daily Sales
    match /daily_sales/{saleId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Inventory
    match /inventory/{inventoryId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Waste Log
    match /waste_log/{wasteId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Price History
    match /price_history/{historyId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }
  }
}
